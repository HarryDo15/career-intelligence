generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStage {
  WISHLIST
  APPLIED
  SCREENING
  TECHNICAL
  OFFER
  REJECTED
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

enum ChangeSource {
  MANUAL
  EMAIL
  IMPORT
}

enum ReviewStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  timezone      String   @default("Asia/Singapore")
  resumeContext String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  identities    Identity[]
  sessions      Session[]
  applications  Application[]
  profiles      SearchProfile[]
  jobs          DiscoveredJob[]
  outlook       OutlookConnection?
  contacts      Contact[]
  runs          WorkflowRun[]
  logs          AuditLog[]
}

model Identity {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerSubject   String
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerSubject])
  @@index([userId])
}

model Session {
  id        String @id @default(cuid())
  tokenHash String @unique
  userId    String
  expiresAt DateTime
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Application {
  id               String @id @default(cuid())
  userId           String
  discoveredJobId  String? @unique
  company          String
  title            String
  url              String?
  description      String? @db.Text
  location         String?
  workMode         WorkMode @default(UNKNOWN)
  stage            ApplicationStage @default(WISHLIST)
  notes            String? @db.Text
  salaryMin        Int?
  salaryMax        Int?
  currency         String? @db.VarChar(3)
  appliedAt        DateTime?
  firstResponseAt  DateTime?
  archivedAt       DateTime?
  version          Int @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  discoveredJob    DiscoveredJob? @relation(fields: [discoveredJobId], references: [id], onDelete: SetNull)
  history          StageEvent[]
  emailSignals     EmailSignal[]
  outreach         OutreachDraft[]
  @@index([userId, stage, archivedAt])
  @@index([userId, appliedAt])
}

model StageEvent {
  id            String @id @default(cuid())
  applicationId String
  fromStage     ApplicationStage?
  toStage       ApplicationStage
  source        ChangeSource
  occurredAt    DateTime
  recordedAt    DateTime @default(now())
  // Scoped key such as email:<signalId> or manual:<requestId>.
  idempotencyKey String @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, occurredAt])
}

model SearchProfile {
  id           String @id @default(cuid())
  userId       String
  name         String
  titles       String[]
  keywords     String[]
  excludedKeywords String[]
  locations    String[]
  workModes    WorkMode[]
  enabled      Boolean @default(true)
  lastRunAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches      JobMatch[]
  @@index([enabled, lastRunAt])
  @@index([userId])
}

model DiscoveredJob {
  id           String @id @default(cuid())
  userId       String
  provider     String
  externalId   String
  canonicalUrl String
  company      String
  title        String
  description  String @db.Text
  location     String?
  workMode     WorkMode @default(UNKNOWN)
  publishedAt  DateTime?
  discoveredAt DateTime @default(now())
  dismissedAt  DateTime?
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches      JobMatch[]
  application  Application?
  @@unique([userId, provider, externalId])
  @@index([userId, discoveredAt])
}

model JobMatch {
  profileId String
  jobId     String
  score     Float
  reasons   String[]
  createdAt DateTime @default(now())
  profile   SearchProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job       DiscoveredJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@id([profileId, jobId])
  @@index([jobId])
}

model OutlookConnection {
  id              String @id @default(cuid())
  userId          String @unique
  microsoftAccountId String @unique
  // Encrypted MSAL cache envelope: key version, nonce, ciphertext, auth tag.
  encryptedTokenCache String @db.Text
  scopes          String[]
  connectedAt     DateTime @default(now())
  lastSyncedAt    DateTime?
  reauthRequired  Boolean @default(false)
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cursors         MailSyncCursor[]
  signals         EmailSignal[]
}

model MailSyncCursor {
  id           String @id @default(cuid())
  connectionId String
  folderId     String
  // Treat Graph continuation URLs as sensitive; encrypt before persistence.
  encryptedDeltaLink String? @db.Text
  encryptedNextLink  String? @db.Text
  updatedAt    DateTime @updatedAt
  connection   OutlookConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@unique([connectionId, folderId])
}

model EmailSignal {
  id             String @id @default(cuid())
  connectionId   String
  messageId      String
  applicationId  String?
  receivedAt     DateTime
  proposedStage  ApplicationStage?
  confidence     Float
  classifierVersion String
  reasonCode     String
  reviewStatus   ReviewStatus @default(PENDING)
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  connection     OutlookConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  @@unique([connectionId, messageId])
  @@index([connectionId, reviewStatus])
  @@index([applicationId])
}

model Contact {
  id          String @id @default(cuid())
  userId      String
  name        String
  company     String
  role        String
  linkedInUrl String?
  sourceUrl   String?
  provenance  String
  notes       String? @db.Text
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  drafts      OutreachDraft[]
  @@index([userId, company])
}

model OutreachDraft {
  id              String @id @default(cuid())
  applicationId   String
  contactId       String?
  content         String @db.Text
  templateVersion String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  @@index([applicationId])
  @@index([contactId])
}

model WorkflowRun {
  id          String @id @default(cuid())
  userId      String
  workflow    String
  dedupeKey   String @unique
  status      RunStatus @default(RUNNING)
  attempts    Int @default(0)
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  errorCode   String?
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, workflow, startedAt])
}

model AuditLog {
  id          String @id @default(cuid())
  userId      String
  action      String
  entityType  String
  entityId    String
  correlationId String?
  // Allowlisted operational metadata only; no tokens, resume, or email bodies.
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
