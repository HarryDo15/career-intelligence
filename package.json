{
  "name": "career-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:local": "tsx scripts/local-db.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "setup:env": "tsx scripts/setup-env.ts",
    "test:http": "tsx scripts/http-smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "workflows:dev": "inngest dev --host 127.0.0.1 --no-discovery -u http://127.0.0.1:3100/api/inngest",
    "test:workflow": "tsx scripts/workflow-smoke.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "inngest-cli": "^1.45.1",
    "prettier": "^3.9.7",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "inngest": "^4.21.0",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "mysql2": "3.24.4",
    "inngest-cli": {
      "adm-zip": "0.6.1"
    }
  }
}
